{
  "name": "ssb-dataportal",
  "version": "0.17.0",
  "private": true,
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "next dev",
    "dev:debug": "NODE_OPTIONS='--inspect' next dev",
    "build": "next build",
    "start": "next start",
    "dev:test": "NODE_ENV=test next dev",
    "build:test": "NODE_ENV=test next build",
    "start:test": "NODE_ENV=test next start -p 3000",
    "build:test:unauth": "NODE_ENV=test IS_AUTHENTICATED=false next build",
    "start:test:unauth": "NODE_ENV=test IS_AUTHENTICATED=false next start -p 8000",
    "lint:check": "biome check .",
    "lint:fix": "biome check --write  .",
    "lint:dead-code": "fallow dead-code",
    "format:check": "biome format  .",
    "format:fix": "biome format --write . ",
    "setup:dev": "pnpm install && which pre-commit && pre-commit install",
    "setup:test:e2e": "pnpm playwright install",
    "types:check": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:update-snapshots": "vitest -u",
    "test:e2e": "playwright test",
    "test:e2e:no-accessibility": "playwright test --grep-invert 'Accessibility'",
    "test:e2e:accessibility": "playwright test --grep 'Accessibility'",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:generate": "pnpm dev & playwright codegen http://localhost:3000",
    "codegen:vardef-internal": "openapi-generator-cli generate --generator-key vardef-internal",
    "codegen:klass": "openapi-generator-cli generate --generator-key klass",
    "codegen:datadoc": "openapi-generator-cli generate --generator-key datadoc"
  },
  "dependencies": {
    "@biomejs/biome": "2.5.0",
    "@digdir/designsystemet-css": "1.18.0",
    "@digdir/designsystemet-react": "1.18.0",
    "@navikt/aksel-icons": "8.16.1",
    "@next/env": "16.2.12",
    "@svgr/webpack": "8.1.0",
    "@types/lodash": "4.17.25",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/react-syntax-highlighter": "15.5.13",
    "classnames": "2.5.1",
    "jose": "6.2.8",
    "next": "16.2.12",
    "nuqs": "2.9.4",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-localization": "2.0.6",
    "react-syntax-highlighter": "16.1.1",
    "server-only": "0.0.1",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@bgotink/playwright-coverage": "0.3.2",
    "@digdir/designsystemet-web": "1.18.0",
    "@openapitools/openapi-generator-cli": "2.40.1",
    "@playwright/cli": "^0.1.17",
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@vitest/coverage-v8": "4.1.10",
    "fallow": "3.12.0",
    "jsdom": "29.1.1",
    "pino-pretty": "13.1.3",
    "ts-node": "10.9.2",
    "typescript-plugin-css-modules": "5.2.0",
    "vite": "8.1.3",
    "vitest": "4.1.10"
  }
}
