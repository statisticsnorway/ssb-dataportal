{
  "name": "metadata-catalog-prototype",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--inspect' next dev",
    "build": "next build",
    "start": "next start",
    "dev:test": "NODE_ENV=test next dev",
    "build:test": "NODE_ENV=test next build",
    "start:test": "NODE_ENV=test next start -p 3000",
    "lint:check": "biome check .",
    "lint:fix": "biome check --write  .",
    "format:check": "biome format  .",
    "format:fix": "biome format --write . ",
    "types:check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "test:update-snapshots": "jest -u",
    "test:e2e": "playwright test",
    "test:e2e:no-accessibility": "playwright test --grep-invert 'Accessibility'",
    "test:e2e:accessibility": "playwright test src/e2e/accessibility-tests.spec.ts",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:generate": "pnpm dev & playwright codegen http://localhost:3000",
    "codegen:vardef-internal": "openapi-generator-cli generate --generator-key vardef-internal",
    "codegen:klass": "openapi-generator-cli generate --generator-key klass",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@biomejs/biome": "2.3.11",
    "@digdir/designsystemet-css": "1.11.1",
    "@digdir/designsystemet-react": "1.11.1",
    "@navikt/aksel-icons": "8.3.0",
    "@next/env": "16.1.6",
    "@svgr/webpack": "8.1.0",
    "@types/node": "25.2.3",
    "classnames": "2.5.1",
    "lodash": "4.17.23",
    "next": "16.1.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-localization": "2.0.6",
    "react-syntax-highlighter": "16.1.0",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@digdir/designsystemet-types": "1.11.1",
    "@openapitools/openapi-generator-cli": "2.28.3",
    "@playwright/test": "1.58.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/jest": "30.0.0",
    "@types/lodash": "4.17.23",
    "@types/react": "19.2.13",
    "@types/react-dom": "19.2.3",
    "@types/react-syntax-highlighter": "15.5.13",
    "jest": "30.2.0",
    "jest-environment-jsdom": "30.2.0",
    "playwright-core": "^1.58.2",
    "ts-node": "10.9.2"
  },
  "resolutions": {
    "glob": "13.0.0",
    "lodash": "4.17.23"
  },
  "packageManager": "pnpm@10.29.2+sha512.bef43fa759d91fd2da4b319a5a0d13ef7a45bb985a3d7342058470f9d2051a3ba8674e629672654686ef9443ad13a82da2beb9eeb3e0221c87b8154fff9d74b8"
}
