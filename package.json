{
  "name": "metadata-catalog-prototype",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--inspect' next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write  .",
    "format:check": "biome format  .",
    "format:fix": "biome format --write . ",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "codegen-vardef-public": "openapi-generator-cli generate -i https://metadata.ssb.no/docs/openapi/variable-definitions/variable-definitions-internal.yml -o src/libs/data-access/variable-definitions/internal -g typescript-fetch --additional-properties=supportsES6=true,npmVersion=6.9.0,typescriptThreePlus=true"
  },
  "dependencies": {
    "@biomejs/biome": "^2.3.5",
    "@digdir/designsystemet-css": "^1.7.1",
    "@digdir/designsystemet-react": "^1.7.1",
    "@digdir/designsystemet-theme": "^1.7.1",
    "@navikt/aksel-icons": "^7.30.1",
    "@svgr/webpack": "^8.1.0",
    "classnames": "^2.5.1",
    "lodash": "^4.17.21",
    "next": "15.5.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-localization": "^2.0.6",
    "sass": "^1.93.2"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.25.2",
    "@playwright/test": "^1.56.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.17",
    "@types/node": "^20",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
