{
  "name": "ssb-dataportal",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:debug": "NODE_OPTIONS='--inspect' next dev",
    "build": "next build",
    "start": "next start",
    "dev:test": "NODE_ENV=test next dev",
    "build:test": "NODE_ENV=test next build",
    "start:test": "NODE_ENV=test next start -p 3000",
    "build:test:unauth": "NODE_ENV=test IS_AUTHENTICATED=false next build",
    "start:test:unauth": "NODE_ENV=test IS_AUTHENTICATED=false next start -p 8000",
    "lint:check": "biome check .",
    "lint:fix": "biome check --write  .",
    "format:check": "biome format  .",
    "format:fix": "biome format --write . ",
    "types:check": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:update-snapshots": "vitest -u",
    "test:e2e": "playwright test",
    "test:e2e:no-accessibility": "playwright test --grep-invert 'Accessibility'",
    "test:e2e:accessibility": "playwright test --grep 'Accessibility'",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:generate": "pnpm dev & playwright codegen http://localhost:3000",
    "codegen:vardef-internal": "openapi-generator-cli generate --generator-key vardef-internal",
    "codegen:klass": "openapi-generator-cli generate --generator-key klass",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@biomejs/biome": "2.4.12",
    "@digdir/designsystemet-css": "1.13.3",
    "@digdir/designsystemet-react": "1.13.3",
    "@navikt/aksel-icons": "8.10.3",
    "@next/env": "16.2.4",
    "@svgr/webpack": "8.1.0",
    "@types/lodash": "4.17.24",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/react-syntax-highlighter": "15.5.13",
    "classnames": "2.5.1",
    "jose": "^6.2.3",
    "lodash": "4.18.1",
    "next": "16.2.4",
    "nuqs": "^2.8.9",
    "pino": "^10.3.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-localization": "2.0.6",
    "react-syntax-highlighter": "16.1.1",
    "react-types": "link:@digdir/designsystemet-react/react-types",
    "server-only": "^0.0.1",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.2",
    "@openapitools/openapi-generator-cli": "2.32.0",
    "@playwright/test": "1.59.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "jsdom": "29.1.0",
    "pino-pretty": "^13.1.3",
    "playwright-core": "^1.59.1",
    "ts-node": "10.9.2",
    "typescript-plugin-css-modules": "^5.2.0",
    "vite": "8.0.10",
    "vitest": "4.1.5"
  },
  "resolutions": {
    "glob": "13.0.6",
    "@nestjs/core": "11.1.18",
    "minimatch": "10.2.5"
  },
  "packageManager": "pnpm@10.33.1+sha512.05ba3c1d5d1c18f68df06470d74055e62d41fc110a0c660db1b2dfb2785327f04cf0f68345d4609bc52089e7fa0343c31593b2f9594e2c5d5da426230acc9820"
}
