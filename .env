# Base env file. Variables defined here will be overridden by any other sources
# of environment variables ref: https://nextjs.org/docs/app/guides/environment-variables#environment-variable-load-order

KLASS_USE_STATIC_DATA=false
KLASS_BASE_PATH=https://data.ssb.no/api/klass/v1

KEYCLOAK_HOST=https://auth.test.ssb.no
KEYCLOAK_ISSUER_PATH=/realms/ssb
KEYCLOAK_JWKS_PATH=/realms/ssb/protocol/openid-connect/certs

USER_AUTH_TOKEN_EXPECTED_AUDIENCE=dataportalen

LOG_LEVEL=info
VARDEF_CACHE_TTL_SECONDS=3600  # 1 hour
M2M_TOKEN_TTL_SECONDS=32400  # 9 hours

NEXT_PUBLIC_LOGIN_URL=/oauth2/login
NEXT_PUBLIC_LOGOUT_URL=/oauth2/logout
