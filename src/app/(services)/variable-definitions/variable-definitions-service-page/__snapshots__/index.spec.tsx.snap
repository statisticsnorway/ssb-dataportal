exports[`VariableDefinitionsServicePage > page renders while waiting for variable definitions 1`] = `
<body>
  <div>
    <main
      id="variableDefinitionsPage"
    >
      <header>
        <h1
          class="ds-heading ds-sr-only"
        >
          Variabeldefinisjoner
        </h1>
      </header>
      <ds-tabpanel
        aria-hidden="true"
        aria-labelledby="variableDefinitionsTab"
        hidden=""
        id="variableDefinitionsTab"
        role="tabpanel"
      >
        #shadow-root
          <slot />
          <style>
            :host(:not([hidden])) { display: block }
          </style>
        <div
          class="_pageContainer_8a24d7 container"
        >
          <div
            class="ds-alert"
            data-color="info"
            style="margin-bottom: 1rem;"
          >
            <h2
              class="ds-heading"
              data-size="sm"
              style="margin-bottom: var(--ds-size-2); font-family: sans-serif;"
            >
              Migrering av variabeldefinisjoner pågår
            </h2>
            <p
              class="ds-paragraph"
              data-variant="default"
            >
              Vi er i gang med å flytte variabeldefinisjoner til SSB Dataportal. Inntil arbeidet er fullført vil noe innhold fortsatt ligge på den gamle siden.
            </p>
            <a
              class="ds-link"
              href="https://www.ssb.no/a/metadata/definisjoner/variabler/main.html"
              rel="noreferrer"
            >
               Finn flere variabeldefinisjoner på ssb.no
            </a>
          </div>
          <section
            aria-label="Tags list"
          />
          <div
            class="_searchHitsContainerWrapper_8a24d7"
          >
            <aside
              aria-label="Filters"
              class="_filterSection_8a24d7"
            >
              <h2
                class="ds-heading"
                data-size="sm"
              >
                Filter
              </h2>
              <input
                label="Filtrer på navn"
              />
              <div
                aria-label="Laster filtere..."
              />
              <div
                aria-label="Laster filtere..."
              />
            </aside>
            <div
              class="_mainSection_8a24d7"
            >
              <div
                class="_hitsAndSort_8a24d7"
              >
                <p
                  class="_numHits_8a24d7"
                />
                <select />
              </div>
              <div
                aria-label="Laster resultater..."
              />
            </div>
          </div>
        </div>
      </ds-tabpanel>
    </main>
  </div>
</body>
`;

