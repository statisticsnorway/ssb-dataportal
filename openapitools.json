{
  "$schema": "https://github.com/OpenAPITools/openapi-generator-cli/raw/refs/heads/master/apps/generator-cli/src/config.schema.json",
  "spaces": 2,
  "generator-cli": {
    "version": "7.17.0",
    "generators": {
      "vardef-internal": {
        "generatorName": "typescript-fetch",
        "output": "src/libs/data-access/variable-definitions/internal",
        "inputSpec": "https://metadata.ssb.no/docs/openapi/variable-definitions/variable-definitions-internal.yml",
        "additionalProperties": {
          "supportsES6": "true",
          "npmVersion": "6.9.0",
          "withInterfaces": true,
          "modelPropertyNaming": "snake_case"
        }
      },
      "klass": {
        "generatorName": "typescript-fetch",
        "output": "src/libs/data-access/klass",
        "inputSpec": "https://data.ssb.no/api/klass/v3/api-docs",
        "additionalProperties": {
          "supportsES6": "true",
          "npmVersion": "6.9.0",
          "withInterfaces": true,
          "enumPropertyNaming": "UPPERCASE",
          "useSingleRequestParameter": true
        }
      },
      "datadoc": {
        "generatorName": "typescript-fetch",
        "output": "src/libs/data-access/datadoc",
        "inputSpec": "src/specs/datadoc-spec.yml",
        "skipValidateSpec": true,
        "additionalProperties": {
          "supportsES6": "true",
          "npmVersion": "6.9.0",
          "withInterfaces": true,
          "enumPropertyNaming": "UPPERCASE",
          "useSingleRequestParameter": true,
          "modelPropertyNaming": "snake_case"
        }
      }
    }
  }
}
